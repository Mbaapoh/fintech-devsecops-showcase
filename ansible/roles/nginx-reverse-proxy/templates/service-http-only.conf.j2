# HTTP-only (no SSL) configuration for {{ item.value.subdomain }}.{{ base_domain }}
# Backend: {{ item.value.backend_host }}:{{ item.value.backend_port }}

server {
    listen 80;
    listen [::]:80;
    server_name {{ item.value.subdomain }}.{{ base_domain }};

    # Security headers
{% for header in security_headers %}
    add_header {{ header }} always;
{% endfor %}

    # Logging
    access_log /var/log/nginx/{{ item.value.subdomain }}.{{ base_domain }}.access.log;
    error_log /var/log/nginx/{{ item.value.subdomain }}.{{ base_domain }}.error.log;

    # Client settings
    client_max_body_size {{ item.value.client_max_body_size }};

    # Proxy settings
    location / {
        proxy_pass http://{{ item.value.backend_host }}:{{ item.value.backend_port }};
        proxy_http_version 1.1;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        
        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout {{ item.value.proxy_read_timeout }};
        proxy_read_timeout {{ item.value.proxy_read_timeout }};
        
        # Buffering
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
